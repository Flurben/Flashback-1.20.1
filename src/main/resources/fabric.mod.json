  "authors": ["Flurben"],
  "contact": {
    "sources": "https://github.com/Flurben/Flashback-1.20.1",
    "issues": "https://github.com/Flurben/Flashback-1.20.1/issues"
  },
  "license": "MIT",
  "icon": "assets/flashback120/icon.png",
